[Unit]
Description=Picmake private editor and sync
After=network.target

[Service]
Type=simple
User=picmake
Group=picmake
WorkingDirectory=/opt/picmake/current
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8790
Environment=PUBLIC_ORIGIN=https://pic.zenohy.uk
Environment=PUBLIC_DIR=/opt/picmake/current/dist
Environment=DATA_DIR=/var/lib/picmake
EnvironmentFile=/etc/picmake.env
ExecStart=/opt/picmake/runtime/node /opt/picmake/current/server/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
UMask=0077
StateDirectory=picmake
StateDirectoryMode=0700
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/picmake
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
